{
  "name": "@kalelaufa/github-mcp-server",
  "version": "2.0.0",
  "description": "Production-ready GitHub MCP Server with full GitHub API coverage",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "github-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "octokit": "^4.1.2",
    "zod": "^3.24.3",
    "dotenv": "^16.4.7",
    "chalk": "^5.4.1",
    "p-limit": "^6.2.0",
    "p-retry": "^6.2.1",
    "lru-cache": "^11.1.0",
    "execa": "^9.5.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "eslint": "^9.22.0",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
