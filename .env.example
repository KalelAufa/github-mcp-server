# GitHub token (personal access token or fine-grained). Any of these names work.
GITHUB_TOKEN=ghp_your_token_here
# GH_TOKEN=ghp_your_token_here
# GITHUB_PAT=ghp_your_token_here

# Defaults applied when a tool call omits owner/repo
GITHUB_DEFAULT_OWNER=your-org
GITHUB_DEFAULT_REPO=your-repo
GITHUB_ORG=your-org

# Where cloned repositories are stored (GitService)
GITHUB_CLONE_DIR=./repos

# Server tuning
GITHUB_MCP_TIMEOUT=30000
GITHUB_MCP_LOG_LEVEL=info
# GITHUB_MCP_PORT=3000
# GITHUB_PROXY=http://proxy.internal:8080
